Tomas & Ava | Wedding

https://fonts.googleapis.com/css2?family=Great+Vibes&family=Poppins:wght@300;400;600&display=swap



*{
margin:0;
padding:0;
box-sizing:border-box;
}

body{
font-family:Poppins,sans-serif;
background:#faf7f2;
color:#333;
overflow-x:hidden;
}

section{
padding:80px 10%;
}

.hero{
height:100vh;
background:
linear-gradient(rgba(0,0,0,.35),rgba(0,0,0,.35)),
url("hero.jpg");
background-size:cover;
background-position:center;
display:flex;
flex-direction:column;
justify-content:center;
align-items:center;
text-align:center;
color:white;
}

.hero h1{
font-family:'Great Vibes',cursive;
font-size:6rem;
}

.hero h2{
font-size:1.4rem;
font-weight:300;
margin:10px 0 20px;
}

.hero p{
font-size:1.1rem;
}

.button{
display:inline-block;
padding:14px 24px;
background:white;
color:black;
text-decoration:none;
border-radius:50px;
margin:10px;
font-weight:bold;
}

.countdown{
display:flex;
justify-content:center;
flex-wrap:wrap;
gap:20px;
margin-top:30px;
}

.time-box{
background:rgba(255,255,255,.2);
padding:20px;
border-radius:20px;
min-width:100px;
backdrop-filter:blur(5px);
}

.time-box span{
display:block;
font-size:2rem;
font-weight:bold;
}

.title{
text-align:center;
font-size:3rem;
font-family:'Great Vibes',cursive;
margin-bottom:40px;
color:#a58852;
}

.story-grid{
display:grid;
grid-template-columns:1fr 1fr;
gap:40px;
align-items:center;
}

.story-grid img{
width:100%;
border-radius:20px;
}

.gallery{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(250px,1fr));
gap:20px;
}

.gallery img{
width:100%;
height:400px;
object-fit:cover;
border-radius:20px;
}

.details{
text-align:center;
background:#f2ece3;
}

.rsvp{
background:white;
text-align:center;
}

input,
textarea,
select{
width:100%;
padding:15px;
margin:10px 0;
border:1px solid #ddd;
border-radius:12px;
}

form{
max-width:600px;
margin:auto;
}

button{
padding:15px 30px;
border:none;
border-radius:50px;
background:#b7955d;
color:white;
font-size:1rem;
cursor:pointer;
}

footer{
text-align:center;
padding:50px;
background:#111;
color:white;
}

@media(max-width:768px){

.hero h1{
font-size:4rem;
}

.story-grid{
grid-template-columns:1fr;
}

}






